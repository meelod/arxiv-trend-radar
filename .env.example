# Example environment variables.
#
# For local development (running pipeline scripts on your laptop):
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values
#   3. The pipeline scripts (pipeline/fetch.py, embed.py, daily_brief.py, trends.py)
#      load .env via python-dotenv when run locally.
#
# For production (GitHub Actions):
#   The same variable NAMES are used, but values come from:
#     - GitHub Secrets    (sensitive)  →  Settings → Secrets and variables → Actions → Secrets
#     - GitHub Variables  (non-sensitive) →  same page, Variables tab
#   See the column below.
#
# This file IS committed to git (it has no real values). Your actual `.env` is
# gitignored — never commit secrets.

# ============================================================================
# REQUIRED
# ============================================================================

# OpenAI API key. GitHub: Secret
# Used by: embed.py, daily_brief.py, trends.py
OPENAI_API_KEY=sk-replace-with-real-key

# Comma-separated list of arXiv category codes to ingest. GitHub: Variable
# Full list of codes: https://arxiv.org/category_taxonomy
# 14-category default below covers ML/CV/NLP/robotics/hardware/security/etc.
CATEGORIES=cs.LG, cs.CL, cs.CV, cs.AR, cs.DC, cs.DB, cs.RO, cs.CR, cs.SE, cs.IR, cs.NE, cs.MA, eess.SP, q-fin.TR

# Multi-line list of stated research interests, used to:
#   1. Pre-filter papers (cosine similarity) before sending to the daily-brief LLM
#   2. Drive top_picks ranking and "why_it_matters" personalization
# GitHub: Secret (so it's not visible on the public repo)
# Each line is a free-text description; the more specific, the better the picks.
INTERESTS="- AI inference infrastructure: specialized silicon, kv-cache management, MoE routing, low-latency serving
- Multi-agent systems and tool-using LLM agents
- Robotics policy learning, especially humanoid manipulation and end-to-end VLA models
- Vector databases, retrieval at scale, ZK proof acceleration
- Quant trading, market microstructure, algorithmic execution
- Hardware-architecture mismatches: where research consolidates on a pattern but industry tools haven't caught up"

# ============================================================================
# OPTIONAL — sensible defaults applied if unset
# ============================================================================

# LLM provider base URL override. Set ONLY for non-OpenAI providers
# (e.g. https://api.deepseek.com). Leave UNSET to use OpenAI.
# IMPORTANT: do not set to an empty string in GitHub Secrets — leave the secret
# unconfigured entirely. The pipeline defensively clears empty strings, but
# best to avoid the trap.
# GitHub: Secret
# OPENAI_BASE_URL=

# LLM model for daily briefing. Default: gpt-4o-mini ($1.50/mo)
# Upgrade to gpt-4o for better synthesis quality (~$12/mo).
# GitHub: Variable
MODEL_NAME=gpt-4o-mini

# LLM model for weekly trends + gap analysis. Default: gpt-5.4-mini (~$0.12/mo)
# Worth upgrading to gpt-4o here ONLY if mini-trends feel shallow ($0.30/mo).
# GitHub: Variable
TRENDS_MODEL_NAME=gpt-5.4-mini

# Embedding model. Default: text-embedding-3-small (~$0.05/mo)
# text-embedding-3-large works but is 6.5× more expensive for marginal gain.
# GitHub: Variable (or omit and use default)
EMBED_MODEL=text-embedding-3-small

# Output language for briefing + trends prose. GitHub: Variable
LANGUAGE=English

# Cap on how many papers the daily-brief LLM call sees, after pre-filtering.
# Lower = cheaper, less serendipity. Higher = risks tokens-per-minute limit.
# Default: 400 (380 most-relevant + 20 wildcards)
# GitHub: Variable (or omit and use default)
BRIEFING_MAX_PAPERS=400

# ============================================================================
# WORKFLOW-ONLY (no equivalent for local runs)
# ============================================================================
#
# These exist only on GitHub for the workflow auto-commits — set as Variables.
#   EMAIL=your.email@example.com
#   NAME=Your Name
#
# These are the git author identity for commits made by the daily/trends/backfill
# workflows when they push generated data back to main.
